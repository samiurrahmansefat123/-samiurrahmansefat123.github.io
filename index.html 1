        >
  
        <div class="product-info">
  
          <p class="product-category">WELLNESS</p>
  
          <h3>Mikeo Fiber XS</h3>
  
          <p class="price">৳ 000</p>
  
          <button onclick="orderProduct('Mikeo Fiber XS', 0)">
